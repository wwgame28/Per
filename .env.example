# Configure in Amvera secrets/settings. Never commit real tokens.
VK_TOKEN=
VK_USER_TOKEN=
VK_GROUP_ID=
DANIL_VK_ID=
ANNA_AUTONOMY=true
DB_PATH=/data/shtab.sqlite3
ASSETS_DIR=/data/assets
LLAMA_URL=http://127.0.0.1:8081
PORT=8080
TZ=Asia/Yakutsk
MAX_AUTONOMOUS_MESSAGES=30
MAX_POSTS_PER_DAY=2
USER_COOLDOWN_SECONDS=120
# 0 disables proactive post creation. Use >=60 minutes after setting /anna goals.
INITIATIVE_INTERVAL_MINUTES=0
MODEL_PATH=/data/model.gguf
PARALLEL=1
GOMAXPROCS=1
GOMEMLIMIT=96MiB
